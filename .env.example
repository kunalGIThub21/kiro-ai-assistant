# KIVO Server Environment Variables (Configure these in Vercel Project Settings -> Environment Variables)
# NEVER commit a populated .env file to Git!

# Required: Google Gemini API key (keep secret on server only; never put in frontend code)
GEMINI_API_KEY=

# Required in production: Long random 64-char hex secret for signing HttpOnly session tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional Admin Credentials (admin routes fail closed with 503 if not configured)
ADMIN_USERNAME=
# Format: scrypt$<32-char-hex-salt>$<128-char-hex-hash>
# Generate hash with: node scripts/hash-password.js "YourStrongAdminPassword"
ADMIN_PASSWORD_HASH=

# Optional comma-separated allowed CORS origins (production defaults to https://kivo-ai-assistant.vercel.app)
ALLOWED_ORIGINS=https://kivo-ai-assistant.vercel.app

# Optional Upstash Redis / Vercel KV for persistent multi-instance user store & distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NODE_ENV=production
